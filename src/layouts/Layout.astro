---
const base = import.meta.env.BASE_URL;
const siteUrl = Astro.site ? new URL(base, Astro.site).href : base;
const ogImage = new URL('imgs/img_00.jpeg', siteUrl).href;
---
<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		
		<!-- Update favicon links - add ICO file first for better search engine recognition -->
		<link rel="icon" type="image/x-icon" href={`${base}favicon.ico`}>
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		
		<!-- SEO Meta Tags -->
		<meta name="description" content="buscando a Hopper: una exploración fotográfica de la soledad" />
		<meta name="keywords" content="fotografía, arte, Hopper, portafolio, España, momentos, visual, documental" />
		<meta name="author" content="Orlando Angulo" />
		
		<!-- Open Graph / Social Media -->
		<meta property="og:title" content="buscando a Hopper" />
		<meta property="og:description" content="una exploración fotográfica de la soledad" />
		<meta property="og:image" content={ogImage} />
		<meta property="og:url" content={siteUrl} />
		<meta property="og:type" content="website" />
		
		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		
		<!-- Page-level caching -->
		<meta http-equiv="Cache-Control" content="max-age=86400">
		
		<link href="https://fonts.googleapis.com/css2?family=Merriweather:wght@300;400&display=swap" rel="stylesheet">
		<meta name="generator" content={Astro.generator} />
		<title>buscando a Hopper</title>
		<link rel="canonical" href={siteUrl} />
		
		<!-- Apple Touch Icon -->
		<link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`}>
		
		<!-- Additional favicon formats -->
		<link rel="icon" type="image/png" sizes="32x32" href={`${base}favicon-32x32.png`}>
		<link rel="icon" type="image/png" sizes="16x16" href={`${base}favicon-16x16.png`}>
		
		<!-- Web App Manifest -->
		<link rel="manifest" href={`${base}site.webmanifest`}>
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--background: #000000;
		--text: #ffffff;
	}
	
	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	html,
	body {
		margin: 0 !important;
		padding: 0 !important;
		width: 100vw !important;
		min-height: 100vh;
		background-color: var(--background);
		color: var(--text);
		overflow-x: hidden !important;
		max-width: 100vw !important;
	}

	body {
		position: relative !important;
		left: 0 !important;
		right: 0 !important;
	}

	main {
		position: relative !important;
		width: 100vw !important;
		overflow-x: hidden !important;
		margin: 0 !important;
		padding: 0 !important;
	}

	img {
		max-width: 100%;
		height: auto;
	}
</style>

<script>
	if (history.scrollRestoration) {
		history.scrollRestoration = 'manual';
	}
	window.scrollTo(0, 0);
</script>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "VisualArtwork",
  "name": "buscando a Hopper",
  "creator": {
    "@type": "Person",
    "name": "Orlando Angulo"
  },
  "artform": "Photography",
  "description": "una exploración fotográfica de la soledad",
  "url": siteUrl
})} />

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "buscando a Hopper",
  "url": siteUrl,
  "potentialAction": {
    "@type": "SearchAction",
    "target": `${siteUrl}?q={search_term_string}`,
    "query-input": "required name=search_term_string"
  }
})} />
